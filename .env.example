# Copy this file to .env and fill in your values.

# Hugging Face access token (free): https://huggingface.co/settings/tokens
# When set, workout & diet plans are written by the language model below.
# When empty, the built-in rule-based plans are used instead.
HF_TOKEN=

# Optional: override the text model used for plan generation.
HF_MODEL=Qwen/Qwen2.5-72B-Instruct

# Optional: override the vision model used for physique photo analysis.
HF_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# Token required to read contact submissions via GET /api/contacts
# (send it as the X-Admin-Token header). Leave empty to disable that endpoint.
ADMIN_TOKEN=

# Comma-separated allowed CORS origins. "*" is fine for local development.
ALLOWED_ORIGINS=*
